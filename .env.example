# === QUICK START ===
# Copy one of these files based on your setup:
#   cp .env.self-hosted .env                      # Local dev: PostgreSQL + Redis
#   cp .env.aws-explicit .env                     # AWS with explicit endpoints (no keys)
#   cp .env.aws-discovery .env                    # AWS with discovery (needs IAM role)
#   cp .env.mixed-aws-rds-self-hosted-redis .env  # AWS RDS + local Redis
#   cp .env.mixed-self-hosted-postgres-aws-elasticache .env  # Local PostgreSQL + AWS ElastiCache

# === SERVER ===
APP_PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# === DATABASE: Self-Hosted ===
DATABASE_PROVIDER=self-hosted
DATABASE_URL=postgres://app:app@localhost:5432/shop

# === DATABASE: AWS RDS (with Discovery - requires RDS_INSTANCE_IDENTIFIER + AWS credentials) ===
# DATABASE_PROVIDER=aws
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# RDS_INSTANCE_IDENTIFIER=shop-postgres
# RDS_DATABASE=shop
# RDS_USERNAME=app
# RDS_PASSWORD=...

# === DATABASE: AWS RDS (with Explicit Endpoint - no AWS credentials needed) ===
# DATABASE_PROVIDER=aws
# RDS_HOST=shop-postgres.abc123.us-east-1.rds.amazonaws.com
# RDS_PORT=5432
# RDS_DATABASE=shop
# RDS_USERNAME=app
# RDS_PASSWORD=...

# === CACHE: Self-Hosted ===
CACHE_PROVIDER=self-hosted
REDIS_URL=redis://localhost:6379
# REDIS_TLS=false                          # Enable TLS for Redis
# REDIS_TLS_INSECURE=false                 # Skip certificate verification (development only)
# REDIS_TLS_CERT_PATH=/path/to/ca.crt     # CA certificate file path

# === CACHE: AWS ElastiCache (with Discovery - requires ELASTICACHE_REPLICATION_GROUP_ID + AWS credentials) ===
# CACHE_PROVIDER=aws
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# ELASTICACHE_REPLICATION_GROUP_ID=shop-redis
# ELASTICACHE_TLS=true
# ELASTICACHE_TLS_INSECURE=false           # Skip certificate verification (development only)
# ELASTICACHE_TLS_CERT_PATH=/path/to/ca.crt  # CA certificate file path
# ELASTICACHE_USERNAME=default             # Optional; defaults to "default" if not provided
# ELASTICACHE_PASSWORD=...

# === CACHE: AWS ElastiCache (with Explicit Endpoint - no AWS credentials needed) ===
# CACHE_PROVIDER=aws
# ELASTICACHE_HOST=shop-redis.abc123.ng.0001.apse1.cache.amazonaws.com
# ELASTICACHE_PORT=6379
# ELASTICACHE_TLS=true
# ELASTICACHE_TLS_INSECURE=false           # Skip certificate verification (development only)
# ELASTICACHE_TLS_CERT_PATH=/path/to/ca.crt  # CA certificate file path
# ELASTICACHE_USERNAME=default             # Optional; defaults to "default" if not provided
# ELASTICACHE_PASSWORD=...

# === CACHE BEHAVIOR ===
CACHE_TTL_SECONDS=60
CACHE_KEY_PREFIX=shop-demo
DEFAULT_PAGE_SIZE=20
CACHE_ENABLED=true
CACHE_INVALIDATION_ENABLED=true
CACHE_INVALIDATION_INTERVAL_MS=30000

# === CONNECTION RETRY ===
CONNECTION_RETRY_ATTEMPTS=8
CONNECTION_RETRY_BASE_DELAY_MS=1000
