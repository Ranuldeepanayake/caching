APP_PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PROVIDER=self-hosted
CACHE_PROVIDER=self-hosted
DATABASE_URL=postgres://app:app@localhost:5432/shop
REDIS_URL=redis://localhost:6379

# AWS provider settings. Set provider to aws to use discovery or explicit endpoints.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
RDS_INSTANCE_IDENTIFIER=
RDS_HOST=
RDS_PORT=5432
RDS_DATABASE=shop
RDS_USERNAME=app
RDS_PASSWORD=app
ELASTICACHE_REPLICATION_GROUP_ID=
ELASTICACHE_HOST=
ELASTICACHE_PORT=6379
ELASTICACHE_TLS=false
ELASTICACHE_USERNAME=
ELASTICACHE_PASSWORD=

CACHE_TTL_SECONDS=60
CACHE_KEY_PREFIX=shop-demo
DEFAULT_PAGE_SIZE=20
CACHE_ENABLED=true
CONNECTION_RETRY_ATTEMPTS=8
CONNECTION_RETRY_BASE_DELAY_MS=1000
