# AWS Configuration with Explicit Endpoints (No Discovery)
# Directly specify RDS and ElastiCache endpoints. No AWS credentials needed.
#
# Best for:
# - Private endpoints (VPC endpoints, private network)
# - When you already know the endpoint
# - Avoiding AWS SDK discovery calls
# - Local development against AWS services

# Server
APP_PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=https://cache.example.com

# AWS region (optional; only used for SDK defaults, not for endpoint discovery)
AWS_REGION=us-east-1
# No AWS credentials needed when using explicit endpoints!

# Database: AWS RDS (explicit endpoint, no discovery)
DATABASE_PROVIDER=aws
RDS_HOST=shop-postgres.abc123.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=shop
RDS_USERNAME=app
RDS_PASSWORD=your-rds-password

# Cache: AWS ElastiCache (explicit endpoint, no discovery)
CACHE_PROVIDER=aws
ELASTICACHE_HOST=shop-redis.abc123.ng.0001.apse1.cache.amazonaws.com
ELASTICACHE_PORT=6379
ELASTICACHE_TLS=true
ELASTICACHE_USERNAME=default
ELASTICACHE_PASSWORD=your-elasticache-password

# Cache behavior
CACHE_TTL_SECONDS=60
CACHE_KEY_PREFIX=shop-demo
DEFAULT_PAGE_SIZE=20
CACHE_ENABLED=true
CACHE_INVALIDATION_ENABLED=true
CACHE_INVALIDATION_INTERVAL_MS=30000

# Connection retry
CONNECTION_RETRY_ATTEMPTS=8
CONNECTION_RETRY_BASE_DELAY_MS=1000
