# Self-Hosted Configuration: PostgreSQL + Redis (Local Development)
# No AWS credentials needed. Use this for local development with Docker Compose.

# Server
APP_PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# Database: Self-Hosted PostgreSQL
DATABASE_PROVIDER=self-hosted
DATABASE_URL=postgres://app:app@postgres:5432/shop

# Cache: Self-Hosted Redis
CACHE_PROVIDER=self-hosted
REDIS_URL=redis://:aB3i2bD3f@redis:6379
REDIS_PASSWORD=aB3i2bD3f              # Required for docker-compose interpolation
# TLS configuration (optional)
REDIS_TLS=false
# REDIS_TLS_INSECURE=false              # Set to true to skip certificate verification (development only)
# REDIS_TLS_CERT_PATH=/path/to/ca.crt  # Path to CA certificate file (only if REDIS_TLS=true)

# Cache behavior
CACHE_TTL_SECONDS=60
CACHE_KEY_PREFIX=shop-demo
DEFAULT_PAGE_SIZE=20
CACHE_ENABLED=true
CACHE_INVALIDATION_ENABLED=true
CACHE_INVALIDATION_INTERVAL_MS=30000

# Connection retry
CONNECTION_RETRY_ATTEMPTS=8
CONNECTION_RETRY_BASE_DELAY_MS=1000
