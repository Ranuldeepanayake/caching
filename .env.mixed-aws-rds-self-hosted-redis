# Mixed Configuration: AWS RDS + Self-Hosted Redis
# Uses AWS RDS for the database and self-hosted Redis for caching.

# Server
APP_PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# Database: AWS RDS (explicit endpoint, no discovery needed)
DATABASE_PROVIDER=aws
RDS_HOST=shop-postgres.abc123.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=shop
RDS_USERNAME=app
RDS_PASSWORD=your-rds-password

# Cache: Self-Hosted Redis (local development)
CACHE_PROVIDER=self-hosted
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=aB3i2bD3f              # Required for docker-compose interpolation

# No AWS credentials needed!

# Cache behavior
CACHE_TTL_SECONDS=60
CACHE_KEY_PREFIX=shop-demo
DEFAULT_PAGE_SIZE=20
CACHE_ENABLED=true
CACHE_INVALIDATION_ENABLED=true
CACHE_INVALIDATION_INTERVAL_MS=30000

# Connection retry
CONNECTION_RETRY_ATTEMPTS=8
CONNECTION_RETRY_BASE_DELAY_MS=1000
