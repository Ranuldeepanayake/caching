# AWS Configuration with Discovery (Using Instance Identifiers)
# AWS SDK discovers RDS and ElastiCache endpoints from identifiers.
# Requires AWS credentials with DescribeDBInstances and DescribeReplicationGroups permissions.
#
# Best used with IAM roles on EC2/ECS/EKS (credentials provided by platform).
# For local development or static credentials, use .env.aws-explicit instead.

# Server
APP_PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=https://cache.example.com

# AWS region and credentials (IAM role preferred on EC2/ECS/EKS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token  # Only if using temporary credentials

# Database: AWS RDS (discovered from instance identifier)
DATABASE_PROVIDER=aws
RDS_INSTANCE_IDENTIFIER=shop-postgres
RDS_DATABASE=shop
RDS_USERNAME=app
RDS_PASSWORD=your-rds-password

# Cache: AWS ElastiCache (discovered from replication group ID)
CACHE_PROVIDER=aws
ELASTICACHE_REPLICATION_GROUP_ID=shop-redis
# TLS configuration
ELASTICACHE_TLS=true
# ELASTICACHE_TLS_INSECURE=false           # Set to true to skip certificate verification (development only)
# ELASTICACHE_TLS_CERT_PATH=/path/to/ca.crt  # Path to CA certificate file
ELASTICACHE_USERNAME=default
ELASTICACHE_PASSWORD=your-elasticache-password

# Cache behavior
CACHE_TTL_SECONDS=60
CACHE_KEY_PREFIX=shop-demo
DEFAULT_PAGE_SIZE=20
CACHE_ENABLED=true
CACHE_INVALIDATION_ENABLED=true
CACHE_INVALIDATION_INTERVAL_MS=30000

# Connection retry
CONNECTION_RETRY_ATTEMPTS=8
CONNECTION_RETRY_BASE_DELAY_MS=1000
