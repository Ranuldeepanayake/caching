# Mixed Configuration: Self-Hosted PostgreSQL + AWS ElastiCache
# Uses self-hosted PostgreSQL for the database and AWS ElastiCache for caching.

# Server
APP_PORT=3000
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000

# Database: Self-Hosted PostgreSQL (local development)
DATABASE_PROVIDER=self-hosted
DATABASE_URL=postgres://app:app@localhost:5432/shop

# Cache: AWS ElastiCache (explicit endpoint, no discovery)
CACHE_PROVIDER=aws
ELASTICACHE_HOST=shop-redis.abc123.ng.0001.apse1.cache.amazonaws.com
ELASTICACHE_PORT=6379
ELASTICACHE_TLS=true
ELASTICACHE_USERNAME=default
ELASTICACHE_PASSWORD=your-elasticache-password

# No AWS credentials needed!

# Cache behavior
CACHE_TTL_SECONDS=60
CACHE_KEY_PREFIX=shop-demo
DEFAULT_PAGE_SIZE=20
CACHE_ENABLED=true
CACHE_INVALIDATION_ENABLED=true
CACHE_INVALIDATION_INTERVAL_MS=30000

# Connection retry
CONNECTION_RETRY_ATTEMPTS=8
CONNECTION_RETRY_BASE_DELAY_MS=1000
